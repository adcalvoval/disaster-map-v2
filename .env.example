# IFRC GO API Configuration (Optional)
# Get your token from https://goadmin.ifrc.org/
IFRC_GO_API_TOKEN=your_token_here
IFRC_GO_API_BASE_URL=https://goadmin.ifrc.org/api/v2

# Server Configuration
PORT=3003

# Authentication Configuration
# Generate a password hash by running: node generate-password.js
# Then paste the hash below
APP_PASSWORD_HASH=your_bcrypt_hash_here
SESSION_SECRET=your_random_secret_here